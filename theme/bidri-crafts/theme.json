          "color": "#111110",
          "name": "Hero black"
        },
        {
          "slug": "text-body",
          "color": "#3F3B35",
          "name": "Body text"
        },
        {
          "slug": "muted",
          "color": "#5F5A52",
          "name": "Muted"
        },
        {
          "slug": "line",
          "color": "#D8D2C8",
          "name": "Line"
        },
        {
          "slug": "border",
          "color": "#CFC8BC",
          "name": "Border"
        },
        {
          "slug": "card-border",
          "color": "#E4DFD6",
          "name": "Card border"
        },
        {
          "slug": "dash",
          "color": "#BFB8AC",
          "name": "Dash"
        },
        {
          "slug": "silver",
          "color": "#CFCBC3",
          "name": "Silver"
        },
        {
          "slug": "burgundy",
          "color": "#6D001A",
          "name": "Burgundy (primary action only)"
        },
        {
          "slug": "on-burgundy",
          "color": "#FFF7F8",
          "name": "On burgundy"
        },
        {
          "slug": "silver-dim",
          "color": "#A9A49B",
          "name": "Silver dim"
        },
        {
          "slug": "success",
          "color": "#2F5D3A",
          "name": "Success"
        }
      ],
      "gradients": [
        {
          "slug": "silk",
          "name": "Silk burgundy (primary action only)",
          "gradient": "linear-gradient(135deg, #93183A 0%, #6D001A 40%, #4F0012 70%, #7C0B27 100%)"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Cormorant Garamond",
          "fontFamily": "\"Cormorant Garamond\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin-500-normal.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin-ext-500-normal.woff2"
              ],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin-600-normal.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin-ext-600-normal.woff2"
              ],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin-700-normal.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin-ext-700-normal.woff2"
              ],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Jost",
          "fontFamily": "Jost, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Jost",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/jost-latin-400-normal.woff2"
              ]
            },
            {
              "fontFamily": "Jost",
              "fontWeight": "500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/jost-latin-500-normal.woff2"
              ]
            },
            {
              "fontFamily": "Jost",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/jost-latin-600-normal.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "eyebrow",
          "name": "Eyebrow",
          "size": "0.8125rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "lead",
          "name": "Lead",
          "size": "1.0625rem",
          "fluid": false
        },
        {
          "slug": "card-title",
          "name": "Card title",
          "size": "1.4375rem",
          "fluid": {
            "min": "1.1875rem",
            "max": "1.4375rem"
          }
        },
        {
          "slug": "h3",
          "name": "H3",
          "size": "1.875rem",
          "fluid": {
            "min": "1.5rem",
            "max": "1.875rem"
          }
        },
        {
          "slug": "h2",
          "name": "Section heading",
          "size": "2.5rem",
          "fluid": {
            "min": "1.875rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "h2-feature",
          "name": "Feature heading",
          "size": "3.25rem",
          "fluid": {
            "min": "2rem",
            "max": "3.25rem"
          }
        },
        {
          "slug": "h1",
          "name": "Page title",
          "size": "3.75rem",
          "fluid": {
            "min": "2.5rem",
            "max": "3.75rem"
          }
        },
        {
          "slug": "hero",
          "name": "Hero",
          "size": "5.5rem",
          "fluid": {
            "min": "3rem",
            "max": "5.5rem"
          }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "10",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "S",
          "size": "0.75rem"
        },
        {
          "slug": "30",
          "name": "M",
          "size": "1.25rem"
        },
        {
          "slug": "40",
          "name": "L",
          "size": "2rem"
        },
        {
          "slug": "50",
          "name": "XL",
          "size": "3.5rem"
        },
        {
          "slug": "60",
          "name": "2XL",
          "size": "clamp(3.5rem, 6vw, 5.5rem)"
        }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "silk",
          "name": "Silk",
          "shadow": "inset 0 1px 0 rgba(255,255,255,0.22), 0 12px 28px -10px rgba(109,0,26,0.6)"
        }
      ]
    },
    "custom": {
      "radius": {
        "card": "16px",
        "panel": "20px",
        "thumb": "12px",
        "icon": "10px",
        "pill": "999px"
      },
      "touchTarget": "44px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--ground)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.5"
    },
    "spacing": {
      "padding": {
        "left": "clamp(20px, 3vw, 32px)",
        "right": "clamp(20px, 3vw, 32px)"
      },
      "blockGap": "1.25rem"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--muted)"
          }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--preset--color--ink)",
            "style": "solid",
            "width": "2px",
            "offset": "2px"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.1"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-1)",
          "lineHeight": "1",
          "letterSpacing": "-0.01em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-2)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-3)"
        }
      },
      "button": {
        "color": {
          "background": "transparent",
          "text": "var(--wp--preset--color--ink)"
        },
        "border": {
          "color": "var(--wp--preset--color--ink)",
          "width": "1px",
          "style": "solid",
          "radius": "999px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "1rem",
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--ink)",
            "text": "var(--wp--preset--color--surface)"
          }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--preset--color--ink)",
            "style": "solid",
            "width": "2px",
            "offset": "2px"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "color": {
          "text": "var(--wp--preset--color--muted)"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "1.3125rem",
          "fontWeight": "600"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "1.5rem",
          "fontWeight": "600"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--line)"
        }
      },
      "woocommerce/product-price": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-1)",
          "lineHeight": "1"
        }
      },
      "core/details": {
        "border": {
          "top": {
            "color": "var(--wp--preset--color--line)",
            "width": "1px",
            "style": "solid"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ],
  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Full width, no title (Our Craft, landing pages)",
      "postTypes": [
        "page"
      ]
    }
  ]
}